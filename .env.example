# Для локального режима переменные не нужны.
# Чтобы включить реальный tool-calling через совместимое Chat Completions API:
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Возможность выбрать модель поиска: tfidf (по умолчанию) или embeddings
RETRIEVER=tfidf
# Если embeddings, скачайте модель отдельно, см. README
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
